# Production 기본값.
# QA Lab 은 운영 빌드에서 라우트와 개발용 도구를 모두 숨깁니다. (docs/02 FR-017)
VITE_ENABLE_QA_LAB=false

# 아직 실제 구현이 없는 기능은 꺼 둡니다.
VITE_ENABLE_CAMERA=false
VITE_ENABLE_FRIEND_ROOM=false
VITE_ENABLE_REALTIME=false
VITE_ENABLE_PIP=false

# 캠퍼스 테마·영토전은 프로토타입입니다. Production 기본값은 false 로 고정합니다.
# Production Supabase 에는 campus migration 을 적용하지 않았습니다.
VITE_ENABLE_CAMPUS_THEME=false
VITE_ENABLE_CAMPUS_TERRITORY=false
VITE_ENABLE_CAMPUS_SUPABASE=false
